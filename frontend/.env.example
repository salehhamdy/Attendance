# Universal Attendance System - Environment Variables

# Supabase Backend Configuration
# 1. Create a project at https://supabase.com
# 2. Run the migration script in supabase/migrations/20261103000000_initial_schema.sql
# 3. Fill in your project URL and public Anon Key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_USE_SUPABASE=false

# In-memory Mock Engine (for standalone testing / preview without backend)
VITE_MOCK=1

# Optional: FastAPI Backend Proxy Target (when using Python backend)
API_TARGET=http://localhost:8000
